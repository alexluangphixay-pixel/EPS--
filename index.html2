 pliers:'<path class="s" d="M26 6 L33 28 L44 58"/><path class="s" d="M38 6 L31 28 L20 58"/><path class="sa" d="M44 58 L38 42"/><path class="sa" d="M20 58 L26 42"/><circle class="f" cx="32" cy="29" r="3.5"/>',
 spanner:'<circle class="f" cx="32" cy="17" r="13"/><rect class="bg" x="27" y="2" width="10" height="14"/><rect class="f" x="27.5" y="28" width="9" height="30" rx="4.5"/>',
 hexkey:'<path class="s" d="M14 8 L14 50 L54 50" style="stroke-width:7"/><path class="sa" d="M14 8 L14 20" style="stroke-width:7"/>',
 caliper:'<rect class="f" x="4" y="20" width="56" height="9" rx="2"/><rect class="f" x="4" y="20" width="7" height="34" rx="2"/><rect class="fa" x="32" y="20" width="8" height="30" rx="2"/><path class="s" d="M14 20 L14 15 M22 20 L22 17 M30 20 L30 15 M46 20 L46 17 M54 20 L54 15" style="stroke-width:2"/>',
 hammer:'<rect class="f" x="10" y="8" width="40" height="16" rx="3"/><rect class="f" x="46" y="12" width="8" height="8" rx="2"/><rect class="fa" x="26" y="24" width="8" height="34" rx="4"/>',
 screwdriver:'<rect class="fa" x="23" y="5" width="18" height="24" rx="7"/><rect class="f" x="30" y="28" width="4" height="22"/><path class="f" d="M29 50 L35 50 L32 59 Z"/>',
 nipper:'<path class="f" d="M20 8 L30 10 L29 24 L20 22 Z"/><path class="f" d="M44 8 L34 10 L35 24 L44 22 Z"/><path class="s" d="M28 22 L33 30 L43 58"/><path class="s" d="M36 22 L31 30 L21 58"/><path class="sa" d="M43 58 L38 44"/><path class="sa" d="M21 58 L26 44"/>',
 scissors:'<circle class="sa" cx="19" cy="49" r="8"/><circle class="sa" cx="45" cy="49" r="8"/><path class="s" d="M23 42 L44 6"/><path class="s" d="M41 42 L20 6"/>',
 drill:'<rect class="f" x="6" y="12" width="36" height="18" rx="5"/><rect class="f" x="42" y="17" width="8" height="8"/><rect class="f" x="50" y="20" width="12" height="2.5"/><rect class="fa" x="14" y="30" width="12" height="24" rx="4"/>',
 saw:'<rect class="fa" x="3" y="24" width="14" height="22" rx="5"/><path class="f" d="M17 26 L61 22 L61 34 L17 44 Z"/><path class="s" d="M19 47 L60 38" style="stroke-width:3;stroke-dasharray:3 3"/>',
 tape:'<rect class="f" x="6" y="8" width="38" height="38" rx="11"/><circle class="bg" cx="25" cy="27" r="9"/><rect class="fa" x="40" y="38" width="22" height="8"/>'
};
function tIcon(id,size){return '<svg class="ic" viewBox="0 0 64 64" width="'+size+'" height="'+size+'" aria-hidden="true">'+TICON[id]+'</svg>';}

const WOOD='#B98A5B',WOOD_D='#6B4A2A',METAL='#8C98AA',METAL_D='#5F6B7D';
function hexPts(cx,cy,r){const p=[];for(let i=0;i<6;i++){const a=Math.PI/180*(60*i+30);p.push((cx+r*Math.cos(a)).toFixed(1)+','+(cy+r*Math.sin(a)).toFixed(1));}return p.join(' ');}
function svgPt(svg,e){const r=svg.getBoundingClientRect(),vb=svg.viewBox.baseVal;return{x:(e.clientX-r.left)/r.width*vb.width,y:(e.clientY-r.top)/r.height*vb.height};}
function cap(el,e){try{el.setPointerCapture(e.pointerId);}catch(_){}}
function actMsg(t){const m=document.getElementById('actmsg');if(m)m.textContent=t;}
function bpath(y){return 'M50 120 Q160 '+(2*y-120)+' 270 120';}

/* scene drawings (320 x 200) */
function sceneRotate(it){
  const k=it.spec.kind;let obj,tool;
  if(k==='nut'){
    obj='<polygon points="'+hexPts(160,100,40)+'" fill="'+METAL+'" stroke="'+METAL_D+'" stroke-width="3"/><circle cx="160" cy="100" r="15" fill="var(--surface)" stroke="'+METAL_D+'" stroke-width="3"/>';
    tool='<rect x="205" y="92" width="85" height="16" rx="8" fill="var(--blue)"/><circle cx="160" cy="100" r="50" fill="none" stroke="var(--blue)" stroke-width="14"/><circle cx="284" cy="100" r="12" fill="var(--blue)" stroke="var(--surface)" stroke-width="3"/>';
  }else if(k==='hexbolt'){
    obj='<polygon points="'+hexPts(160,100,38)+'" fill="'+METAL+'" stroke="'+METAL_D+'" stroke-width="3"/><polygon points="'+hexPts(160,100,14)+'" fill="'+METAL_D+'"/>';
    tool='<rect x="160" y="96" width="124" height="8" rx="4" fill="var(--ink)"/><polygon points="'+hexPts(160,100,11)+'" fill="var(--ink)"/><circle cx="284" cy="100" r="12" fill="var(--blue)" stroke="var(--surface)" stroke-width="3"/>';
  }else{
    obj='<circle cx="160" cy="100" r="40" fill="'+METAL+'" stroke="'+METAL_D+'" stroke-width="3"/><rect x="124" y="94" width="72" height="12" rx="3" fill="'+METAL_D+'"/>';
    let n='';
    for(let i=0;i<8;i++){const a=i*Math.PI/4;n+='<line x1="'+(160+14*Math.cos(a)).toFixed(1)+'" y1="'+(100+14*Math.sin(a)).toFixed(1)+'" x2="'+(160+26*Math.cos(a)).toFixed(1)+'" y2="'+(100+26*Math.sin(a)).toFixed(1)+'" stroke="var(--surface)" stroke-width="3"/>';}
    tool='<circle cx="160" cy="100" r="28" fill="var(--blue)"/>'+n+'<circle cx="160" cy="100" r="8" fill="var(--surface)"/><circle cx="184" cy="100" r="4" fill="var(--on-blue)"/>';
  }
  return '<circle cx="160" cy="100" r="64" fill="none" stroke="var(--line)" stroke-width="6"/><circle id="ring" cx="160" cy="100" r="64" fill="none" stroke="var(--green)" stroke-width="6" stroke-linecap="round" stroke-dasharray="0 402" transform="rotate(-90 160 100)"/><g id="rot">'+obj+tool+'</g>';
}
function sceneTap(){
  return '<rect x="50" y="150" width="220" height="38" rx="4" fill="'+WOOD+'"/><g id="nail" style="transition:transform .09s"><rect x="157" y="70" width="6" height="80" fill="'+METAL+'"/><rect x="150" y="62" width="20" height="8" rx="2" fill="'+METAL_D+'"/></g><g id="ham" style="transform-origin:300px 28px;transform:rotate(18deg);transition:transform .09s"><rect x="128" y="14" width="64" height="26" rx="4" fill="'+METAL_D+'"/><rect x="188" y="20" width="12" height="14" fill="'+METAL_D+'"/><rect x="198" y="22" width="102" height="11" rx="5" fill="var(--blue)"/></g>';
}
function sceneDrill(){
  return '<rect x="50" y="130" width="220" height="56" rx="4" fill="'+WOOD+'"/><rect id="hole" x="154" y="130" width="12" height="0" fill="'+WOOD_D+'"/><g id="drl"><rect x="108" y="14" width="104" height="44" rx="10" fill="var(--blue)"/><rect x="150" y="58" width="20" height="14" fill="'+METAL_D+'"/><rect x="158" y="72" width="4" height="44" fill="'+METAL+'"/></g>';
}
function sceneNipper(){
  return '<g id="wl"><line x1="30" y1="100" x2="160" y2="100" stroke="'+METAL+'" stroke-width="9" stroke-linecap="round"/></g><g id="wr"><line x1="160" y1="100" x2="290" y2="100" stroke="'+METAL+'" stroke-width="9" stroke-linecap="round"/></g><g id="bt"><path d="M136 20 L184 20 L167 72 L153 72 Z" fill="var(--blue)"/></g><g id="bb"><path d="M136 180 L184 180 L167 128 L153 128 Z" fill="var(--blue)"/></g>';
}
function sceneCut(){
  const lines='stroke="var(--line)" stroke-width="3" fill="none"';
  return '<g id="pl"><rect x="60" y="45" width="100" height="110" fill="#fff" stroke="var(--line)" stroke-width="2"/><path d="M76 70H144M76 90H144M76 110H144" '+lines+'/></g><g id="pr"><rect x="160" y="45" width="100" height="110" fill="#fff" stroke="var(--line)" stroke-width="2"/><path d="M176 70H244M176 90H244M176 110H244" '+lines+'/></g><line x1="160" y1="38" x2="160" y2="162" stroke="var(--red)" stroke-width="3" stroke-dasharray="6 6"/><line id="cutdone" x1="160" y1="45" x2="160" y2="45" stroke="var(--green)" stroke-width="5" stroke-linecap="round"/><g id="scs" opacity="0" transform="translate(160 45)"><path id="bl" d="M0 0 L-6 40 M0 0 L6 40" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round"/><path d="M0 0 L-14 -30 M0 0 L14 -30" fill="none" stroke="var(--blue)" stroke-width="5" stroke-linecap="round"/><circle cx="-14" cy="-38" r="8" fill="none" stroke="var(--blue)" stroke-width="4"/><circle cx="14" cy="-38" r="8" fill="none" stroke="var(--blue)" stroke-width="4"/></g>';
}
function sceneSaw(){
  return '<g id="wl"><rect x="50" y="120" width="110" height="52" rx="4" fill="'+WOOD+'"/></g><g id="wr"><rect x="160" y="120" width="110" height="52" rx="4" fill="'+WOOD+'"/></g><rect id="kerf" x="157" y="120" width="6" height="0" fill="'+WOOD_D+'"/><g id="saw"><rect x="86" y="84" width="150" height="22" rx="3" fill="'+METAL+'"/><line x1="90" y1="108" x2="232" y2="108" stroke="'+METAL_D+'" stroke-width="5" stroke-dasharray="4 4"/><rect x="230" y="62" width="42" height="50" rx="12" fill="var(--blue)"/></g>';
}
function sceneExtend(it){
  const P=it.params;
  if(it.spec.kind==='caliper'){
    let t='',th='';
    for(let i=0;i<=16;i++){t+='M'+(44+i*15)+' 60 v'+(i%5===0?12:7)+' ';}
    for(let x=84;x<76+P.len;x+=8){th+='M'+x+' 92 l4 16 ';}
    return '<rect x="40" y="38" width="260" height="22" rx="3" fill="#D9DEE7" stroke="#9AA4B5"/><path d="'+t+'" stroke="#5F6B7D" stroke-width="1.5" fill="none"/><rect x="70" y="38" width="6" height="86" fill="var(--ink)"/><rect x="58" y="84" width="18" height="32" rx="3" fill="'+METAL_D+'"/><rect x="76" y="92" width="'+P.len+'" height="16" fill="'+METAL+'"/><path d="'+th+'" stroke="'+METAL_D+'" stroke-width="2" fill="none"/><g id="mv"><rect x="290" y="38" width="6" height="86" fill="var(--blue)"/><circle cx="299" cy="49" r="13" fill="var(--blue)" stroke="var(--surface)" stroke-width="3"/></g><text id="reading" x="160" y="172" text-anchor="middle" font-size="20" font-weight="700" fill="var(--green)" opacity="0"></text>';
  }
  return '<rect x="60" y="117" width="'+P.len+'" height="6" rx="3" fill="'+METAL+'"/><rect id="strip" x="52" y="98" width="8" height="12" fill="#F2C94C"/><rect x="6" y="80" width="48" height="60" rx="14" fill="var(--ink)"/><circle cx="30" cy="110" r="10" fill="var(--surface)"/><g id="mv"><rect x="60" y="94" width="5" height="46" fill="'+METAL_D+'"/></g><text id="reading" x="160" y="172" text-anchor="middle" font-size="20" font-weight="700" fill="var(--green)" opacity="0"></text>';
}
function sceneBend(it){
  const P=it.params;
  return '<line x1="50" y1="120" x2="270" y2="120" stroke="var(--line)" stroke-width="3" stroke-dasharray="6 6"/>'+(P.mode==='bend'?'<path d="M50 120 Q160 20 270 120" fill="none" stroke="var(--blue)" stroke-width="3" stroke-dasharray="6 6" opacity=".5"/>':'')+'<path id="wire" d="'+bpath(P.y0)+'" fill="none" stroke="'+METAL_D+'" stroke-width="8" stroke-linecap="round"/><rect x="36" y="100" width="16" height="40" rx="4" fill="var(--ink)"/><rect x="268" y="100" width="16" height="40" rx="4" fill="var(--ink)"/><g id="knob" transform="translate(160 '+P.y0+')"><path d="M8 8 L40 52 M-8 8 L-30 52" fill="none" stroke="var(--blue)" stroke-width="7" stroke-linecap="round"/><rect x="-17" y="-11" width="34" height="22" rx="5" fill="var(--ink)"/><circle r="4" fill="var(--surface)"/></g>';
}

/* gestures */
function mountRotate(svg,it,fin){
  const g=svg.querySelector('#rot'),ring=svg.querySelector('#ring');
  let total=0,last=null,done=false;
  const ang=e=>{const p=svgPt(svg,e);return Math.atan2(p.y-100,p.x-160);};
  const upd=()=>{
    const pr=Math.min(1,total/540);
    g.setAttribute('transform','rotate('+total.toFixed(1)+' 160 100)');
    ring.setAttribute('stroke-dasharray',(pr*402).toFixed(1)+' 402');
    actMsg(pr<1?'หมุนแล้ว '+Math.round(pr*100)+'%':'');
    if(pr>=1&&!done){done=true;fin();}
  };
  svg.onpointerdown=e=>{if(done)return;cap(svg,e);last=ang(e);};
  svg.onpointermove=e=>{
    if(last==null||done)return;
    const a=ang(e);let d=a-last;
    while(d>Math.PI)d-=2*Math.PI;while(d<-Math.PI)d+=2*Math.PI;
    last=a;total=Math.max(0,total+d*180/Math.PI);upd();
  };
  const up=()=>{last=null;};
  svg.onpointerup=up;svg.onpointercancel=up;
}
function mountTap(svg,it,fin){
  const nail=svg.querySelector('#nail'),ham=svg.querySelector('#ham');
  let n=0,busy=false;
  const pose=(sink,deg)=>{ham.style.transform='translateY('+sink+'px) rotate('+deg+'deg)';};
  pose(0,18);
  svg.onpointerdown=e=>{
    if(busy||n>=5)return;busy=true;
    pose(n*16,-9);
    setTimeout(()=>{
      n++;
      nail.style.transform='translateY('+(n*16)+'px)';
      pose(n*16,18);
      actMsg(n<5?'ตอกแล้ว '+n+'/5':'');
      busy=false;
      if(n>=5)setTimeout(fin,250);
    },90);
  };
}
function mountHold(svg,it,fin){
  const btn=document.getElementById('holdbtn');if(!btn)return;
  const isDrill=it.spec.act==='drill',T=isDrill?2000:800;
  const drl=svg.querySelector('#drl'),hole=svg.querySelector('#hole'),bt=svg.querySelector('#bt'),bb=svg.querySelector('#bb'),wl=svg.querySelector('#wl'),wr=svg.querySelector('#wr');
  let p=0,last=0,raf=0,held=false,done=false;
  const apply=()=>{
    if(isDrill){const tr=p*54;drl.setAttribute('transform','translate(0 '+tr.toFixed(1)+')');hole.setAttribute('height',Math.max(0,tr-14).toFixed(1));}
    else{const tr=p*28;bt.setAttribute('transform','translate(0 '+tr.toFixed(1)+')');bb.setAttribute('transform','translate(0 '+(-tr).toFixed(1)+')');if(p>=1){wl.setAttribute('transform','translate(-8 -3)');wr.setAttribute('transform','translate(8 3)');}}
    actMsg(p<1?Math.round(p*100)+'%':'');
  };
  const step=t=>{
    if(!held)return;
    p=Math.min(1,p+Math.max(0,t-last)/T);last=t;apply();
    if(p>=1){done=true;held=false;btn.classList.remove('on');btn.textContent='เสร็จแล้ว';fin();return;}
    raf=requestAnimationFrame(step);
  };
  btn.onpointerdown=e=>{if(done)return;e.preventDefault();cap(btn,e);held=true;btn.classList.add('on');last=performance.now();raf=requestAnimationFrame(step);};
  const up=()=>{held=false;btn.classList.remove('on');cancelAnimationFrame(raf);};
  btn.onpointerup=up;btn.onpointercancel=up;btn.oncontextmenu=e=>e.preventDefault();
}
function mountCut(svg,it,fin){
  const line=svg.querySelector('#cutdone'),pl=svg.querySelector('#pl'),pr=svg.querySelector('#pr'),scs=svg.querySelector('#scs'),bl=svg.querySelector('#bl');
  let a=null,b=null,drag=false,done=false;
  const mv=e=>{
    const p=svgPt(svg,e);
    const sx=Math.max(60,Math.min(260,p.x)),sy=Math.max(45,Math.min(155,p.y));
    const s=Math.tan((6+(Math.sin(sy/4)+1)*5)*Math.PI/180)*40;
    scs.setAttribute('opacity','1');scs.setAttribute('transform','translate('+sx.toFixed(1)+' '+sy.toFixed(1)+')');
    bl.setAttribute('d','M0 0 L'+(-s).toFixed(1)+' 40 M0 0 L'+s.toFixed(1)+' 40');
    if(Math.abs(p.x-160)>34)return;
    a=a==null?sy:Math.min(a,sy);b=b==null?sy:Math.max(b,sy);
    line.setAttribute('y1',a);line.setAttribute('y2',b);
    const cov=(b-a)/110;
    actMsg(cov<0.85?'ตัดไปแล้ว '+Math.round(cov/0.85*100)+'%':'');
    if(cov>=0.85&&!done){done=true;pl.setAttribute('transform','translate(-14 0) rotate(-3 110 100)');pr.setAttribute('transform','translate(14 0) rotate(3 210 100)');fin();}
  };
  svg.onpointerdown=e=>{if(done)return;drag=true;cap(svg,e);mv(e);};
  svg.onpointermove=e=>{if(drag&&!done)mv(e);};
  const up=()=>{drag=false;};
  svg.onpointerup=up;svg.onpointercancel=up;
}
function mountSaw(svg,it,fin){
  const saw=svg.querySelector('#saw'),kerf=svg.querySelector('#kerf'),wl=svg.querySelector('#wl'),wr=svg.querySelector('#wr');
  const NEED=6;
  let drag=false,done=false,lastX=0,dir=0,acc=0,count=0;
  const upd=x=>{
    const pr=Math.min(1,count/NEED),tx=Math.max(-45,Math.min(45,(x-160)*0.5)),ty=pr*44;
    saw.setAttribute('transform','translate('+tx.toFixed(1)+' '+ty.toFixed(1)+')');
    kerf.setAttribute('height',Math.max(0,ty-12).toFixed(1));
    actMsg(count<NEED?'เลื่อยไปแล้ว '+count+'/'+NEED+' ครั้ง':'');
    if(count>=NEED&&!done){done=true;wl.setAttribute('transform','translate(-8 0)');wr.setAttribute('transform','translate(8 0)');fin();}
  };
  svg.onpointerdown=e=>{if(done)return;drag=true;cap(svg,e);lastX=svgPt(svg,e).x;dir=0;acc=0;};
  svg.onpointermove=e=>{
    if(!drag||done)return;
    const x=svgPt(svg,e).x,dx=x-lastX;lastX=x;
    if(Math.abs(dx)<0.5){upd(x);return;}
    const d=dx>0?1:-1;
    if(dir!==0&&d!==dir){if(Math.abs(acc)>=40)count++;acc=0;}
    dir=d;acc+=dx;upd(x);
  };
  const up=()=>{if(!drag)return;drag=false;if(Math.abs(acc)>=40)count++;acc=0;dir=0;upd(lastX);};
  svg.onpointerup=up;svg.onpointercancel=up;
}
function mountExtend(svg,it,fin){
  const P=it.params,mv=svg.querySelector('#mv'),strip=svg.querySelector('#strip'),rd=svg.querySelector('#reading');
  let x=P.x0,drag=false,done=false;
  const set=nx=>{
    x=Math.max(P.min,Math.min(P.max,nx));
    mv.setAttribute('transform','translate('+(x-P.x0).toFixed(1)+' 0)');
    if(strip)strip.setAttribute('width',Math.max(0,x-52).toFixed(1));
  };
  svg.onpointerdown=e=>{if(done)return;drag=true;cap(svg,e);set(svgPt(svg,e).x);};
  svg.onpointermove=e=>{if(drag&&!done)set(svgPt(svg,e).x);};
  const up=()=>{
    if(!drag||done)return;drag=false;
    if(Math.abs(x-P.target)<=7){done=true;set(P.target);rd.textContent=P.reading;rd.setAttribute('opacity','1');actMsg('');fin();}
    else actMsg(x>P.target?'เลยปลายไปแล้ว ลองใหม่':'ยังไม่ถึงปลาย ลากต่อ');
  };
  svg.onpointerup=up;svg.onpointercancel=up;
}
function mountBend(svg,it,fin){
  const P=it.params,w=svg.querySelector('#wire'),k=svg.querySelector('#knob');
  let y=P.y0,drag=false,done=false;
  const set=ny=>{y=Math.max(30,Math.min(190,ny));w.setAttribute('d',bpath(y));k.setAttribute('transform','translate(160 '+y+')');};
  svg.onpointerdown=e=>{if(done)return;drag=true;cap(svg,e);set(svgPt(svg,e).y);};
  svg.onpointermove=e=>{if(drag&&!done)set(svgPt(svg,e).y);};
  const up=()=>{
    if(!drag||done)return;drag=false;
    const dy=Math.abs(y-120),ok=P.mode==='straighten'?dy<=8:dy>=45;
    if(ok){done=true;if(P.mode==='straighten')set(120);actMsg('');fin();}
    else actMsg(P.mode==='straighten'?'ยังไม่ตรง ลากให้ลวดทับเส้นประ':'ยังงอไม่พอ ลากให้งอมากขึ้น');
  };
  svg.onpointerup=up;svg.onpointercancel=up;
}


/* ---------- the workbench: every tool and material on one table ---------- */
const BENCH_MAT=[
 {id:'wire',ko:'철사',th:'ลวดเหล็ก'},{id:'rebar',ko:'철근',th:'เหล็กเส้น'},{id:'nut',ko:'너트',th:'น็อต'},{id:'screw',ko:'나사못',th:'สกรู'},
 {id:'hexbolt',ko:'육각볼트',th:'โบลต์หกเหลี่ยม'},{id:'nail',ko:'못',th:'ตะปู'},{id:'paper',ko:'종이',th:'กระดาษ'},{id:'wood',ko:'나무판 / 원목',th:'แผ่นไม้ / ไม้ท่อน'}
];
function toolPos(order,id){const i=order.indexOf(id);return{x:54+84*(i%4),y:200+72*Math.floor(i/4)};}
function matPos(order,id){const i=order.indexOf(id);return{x:54+84*(i%4),y:38+70*Math.floor(i/4)};}
function matGlyph(id){
  switch(id){
    case 'wire':return '<path d="M-30 4 q7 -16 15 0 t15 0 t15 0 t15 0" fill="none" stroke="'+METAL_D+'" stroke-width="5" stroke-linecap="round"/>';
    case 'rebar':{let r='';for(let i=0;i<6;i++){r+='M'+(-24+i*9)+' -7 l5 14 ';}return '<rect x="-30" y="-7" width="60" height="14" rx="3" fill="#6B7280"/><path d="'+r+'" stroke="#A3A9B5" stroke-width="2" fill="none"/>';}
    case 'nut':return '<polygon points="'+hexPts(0,0,22)+'" fill="'+METAL+'" stroke="'+METAL_D+'" stroke-width="3"/><circle r="8" fill="#D9BE96" stroke="'+METAL_D+'" stroke-width="2"/>';
    case 'screw':{let t='';for(let x=-16;x<26;x+=6)t+='M'+x+' -6 l3 12 ';return '<rect x="-30" y="-11" width="12" height="22" rx="3" fill="'+METAL_D+'"/><rect x="-18" y="-6" width="46" height="12" fill="'+METAL+'"/><path d="'+t+'" stroke="'+METAL_D+'" stroke-width="1.5" fill="none"/><path d="M28 -6 L34 0 L28 6Z" fill="'+METAL+'"/>';}
    case 'hexbolt':{let t='';for(let x=-6;x<26;x+=6)t+='M'+x+' -7 l3 14 ';return '<rect x="-30" y="-14" width="16" height="28" rx="2" fill="'+METAL_D+'"/><path d="M-26 -14 V14 M-18 -14 V14" stroke="'+METAL+'" stroke-width="1.5"/><rect x="-14" y="-7" width="44" height="14" fill="'+METAL+'"/><path d="'+t+'" stroke="'+METAL_D+'" stroke-width="1.5" fill="none"/>';}
    case 'nail':return '<rect x="-28" y="-9" width="5" height="18" rx="1" fill="'+METAL_D+'"/><rect x="-23" y="-2" width="50" height="4" fill="'+METAL+'"/><path d="M27 -2 L33 0 L27 2Z" fill="'+METAL+'"/>';
    case 'paper':return '<rect x="-24" y="-26" width="48" height="52" fill="#fff" stroke="#9AA4B5" stroke-width="2"/><path d="M-16 -12H16M-16 0H16M-16 12H16" stroke="#C5CCD8" stroke-width="3"/>';
    default:return '<rect x="-32" y="-16" width="64" height="32" rx="3" fill="'+WOOD+'"/><path d="M-26 -6H26M-26 4H20" stroke="'+WOOD_D+'" stroke-width="1.5" opacity=".6"/>';
  }
}
function shortName(s){return String(s).split(' / ')[0];}
function benchSvg(ord,labels){
  let h='<rect width="360" height="400" fill="#D9BE96"/><path d="M0 74H360M0 144H360" stroke="#C9AB80" stroke-width="2"/><rect x="6" y="158" width="348" height="236" rx="14" fill="#7A5C3A"/>';
  ord.mats.forEach(id=>{
    const m=BENCH_MAT.find(x=>x.id===id),p=matPos(ord.mats,id);
    h+='<g transform="translate('+p.x+' '+p.y+')"><rect id="hl_'+id+'" x="-40" y="-32" width="80" height="78" rx="10" fill="none" stroke="var(--blue)" stroke-width="3" opacity="0"/>'+matGlyph(id)+(labels?'<text y="40" text-anchor="middle" font-size="11" font-weight="700" fill="#2B2118">'+m.ko+'</text>':'')+'</g>';
  });
  ord.tools.forEach(id=>{
    const p=toolPos(ord.tools,id);
    h+='<g class="tl" data-id="'+id+'" transform="translate('+p.x+' '+p.y+')" style="cursor:grab"><rect x="-32" y="-30" width="64" height="60" rx="10" fill="var(--surface)"/><svg class="ic" x="-26" y="-26" width="52" height="52" viewBox="0 0 64 64">'+TICON[id]+'</svg>'+(labels?'<text y="46" text-anchor="middle" font-size="11" font-weight="700" fill="#F5E9D8">'+esc(shortName(TNAME[id]))+'</text>':'')+'</g>';
  });
  return h;
}
function mountBench(svg,it,ok){
  const sp=it.spec,ord=sess.bench;
  let drag=null;
  const hit=(x,y)=>{for(const id of ord.mats){const p=matPos(ord.mats,id);if(Math.abs(x-p.x)<=40&&y>=p.y-32&&y<=p.y+46)return id;}return null;};
  const hl=id=>{ord.mats.forEach(m=>{const e=svg.querySelector('#hl_'+m);if(e)e.setAttribute('opacity',m===id?'1':'0');});};
  const mv=e=>{
    if(!drag)return;
    const p=svgPt(svg,e),x=Math.max(20,Math.min(340,p.x)),y=Math.max(30,Math.min(380,p.y-30));
    drag.x=x;drag.y=y;
    drag.el.setAttribute('transform','translate('+x.toFixed(1)+' '+y.toFixed(1)+') scale(1.15)');
    hl(hit(x,y));
  };
  svg.onpointerdown=e=>{
    const el=e.target&&e.target.closest?e.target.closest('.tl'):null;
    if(!el||drag)return;
    cap(svg,e);
    el.style.transition='none';
    svg.appendChild(el);
    drag={id:el.dataset.id,el:el,home:toolPos(ord.tools,el.dataset.id),x:0,y:0};
    mv(e);
  };
  svg.onpointermove=mv;
  const up=()=>{
    if(!drag)return;
    const d=drag;drag=null;hl(null);
    const m=hit(d.x,d.y);
    const home=()=>{d.el.style.transition='transform .18s';d.el.setAttribute('transform','translate('+d.home.x+' '+d.home.y+')');};
    if(m==null){home();actMsg('วางเครื่องมือลงบนวัสดุที่ต้องใช้');return;}
    const toolOk=d.id===sp.tool,matOk=sp.mats.indexOf(m)>=0;
    if(toolOk&&matOk){
      const p=matPos(ord.mats,m);
      d.el.style.transition='transform .18s';
      d.el.setAttribute('transform','translate('+p.x+' '+(p.y-6)+') scale(1.2)');
      setTimeout(ok,220);
      return;
    }
    ui.wrong++;if(ui.wrong>=2)ui.hint=true;
    home();
    if(!toolOk)actMsg(ui.wrong>=2?'ใบ้: ต้องใช้ '+sp.toolKo+' ('+sp.toolTh+')':'ไม่ใช่เครื่องมือที่คำสั่งบอก ลองฟังคำสั่งอีกครั้ง');
    else actMsg(ui.wrong>=2?'ใบ้: ต้องใช้กับ '+sp.op[1]:'เครื่องมือถูกแล้ว แต่วัสดุไม่ตรงกับคำสั่ง');
    speak(it.say);
  };
  svg.onpointerup=up;svg.onpointercancel=up;
}

const SC={
 rotate:{svg:sceneRotate,mount:mountRotate,hint:()=>'ใช้นิ้วลากเป็นวงกลมตามเข็มนาฬิกาเพื่อขัน (ประมาณ 1 รอบครึ่ง)'},
 tap:{svg:sceneTap,mount:mountTap,hint:()=>'แตะที่หน้าจอเพื่อตอก 5 ครั้ง'},
 drill:{svg:sceneDrill,mount:mountHold,extra:'<button class="holdbtn" id="holdbtn">กดค้างเพื่อเจาะ</button>',hint:()=>'กดปุ่มค้างไว้จนสว่านเจาะทะลุ'},
 nipper:{svg:sceneNipper,mount:mountHold,extra:'<button class="holdbtn" id="holdbtn">กดค้างเพื่อบีบคีมตัด</button>',hint:()=>'กดปุ่มค้างไว้จนคีมตัดลวดขาด'},
 cut:{svg:sceneCut,mount:mountCut,hint:()=>'ใช้นิ้วลากตามเส้นประสีแดงจากบนลงล่างเพื่อตัดกระดาษ'},
 saw:{svg:sceneSaw,mount:mountSaw,hint:()=>'ลากนิ้วไปมาซ้าย-ขวา 6 ครั้งเพื่อเลื่อยไม้'},
 extend:{svg:sceneExtend,mount:mountExtend,hint:it=>it.spec.kind==='caliper'?'ลากเพื่อเลื่อนปากวัดมาแตะปลายสกรู':'ลากสายตลับเมตรไปให้ถึงปลายลวด'},
 bend:{svg:sceneBend,mount:mountBend,hint:it=>it.params.mode==='bend'?'ลากขึ้นหรือลงเพื่องอลวดให้โค้ง':'ลากขึ้นลงเพื่อดัดลวดให้ตรงทับเส้นประ'}
};

/* interview questions 21-41: [ko, thai question, [answers], thai answer, spoken form (optional)] */
