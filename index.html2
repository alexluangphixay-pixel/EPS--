 39:['의사소통이 왜 중요한 지 설명할 수 있나요?','อธิบายได้ไหมว่าทำไมการสื่อสารจึงสำคัญ',['서로 잘 알기 위해서입니다.'],'เพื่อให้เข้าใจกันและกัน'],
 40:['사람들 사이에서 지켜야 할 예절에 대해 잘 알고 있나요?','รู้เรื่องมารยาทที่ต้องปฏิบัติระหว่างคนด้วยกันไหม',['인사하고 높임말을 씁니다.'],'ทักทายและใช้คำพูดสุภาพ (높임말)'],
 41:['일하면서 정해진 시간을 잘 지키시나요?','ทำงานแล้วรักษาเวลาที่กำหนดได้ดีไหม',['네, 시간 잘 지키는 편입니다.','네, 시간 잘 지킵니다.'],'ครับ รักษาเวลาได้ดี']
};

const DAYS=['일','월','화','수','목','금','토'];
const TH_DAYS=['อาทิตย์','จันทร์','อังคาร','พุธ','พฤหัสบดี','ศุกร์','เสาร์'];
const TH_MONTHS=['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];

/* ---------- state ---------- */
const DEF_P={name:'',age:'',country:'태국',months:'3',birthY:'',birthM:'',birthD:'',married:'no',kids:'no',family:'',siblings:'',height:'',weight:'',hometown:'',home:''};
const REQ=['name','age','country','months','birthY','birthM','birthD','family','siblings','height','weight','hometown','home'];
let P=Object.assign({},DEF_P,store.get('eps_profile',{}));
let SET=Object.assign({slow:true,hideKo:false,shuffle:false},store.get('eps_settings',{}));
let passed=store.get('eps_passed',{});
let wrong=store.get('eps_wrong',{});
let view='home',sess=null,ui={},mic=null,voiceKo=null;

const SRC=window.SpeechRecognition||window.webkitSpeechRecognition;
const $app=document.getElementById('app');
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const v=k=>String(P[k]==null?'':P[k]).trim();
const num=k=>{const n=parseInt(v(k),10);return isNaN(n)?null:n;};
const rand=n=>Math.floor(Math.random()*n);
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=rand(i+1);const t=a[i];a[i]=a[j];a[j]=t;}return a;}
function range(a,b){const r=[];for(let i=a;i<=b;i++)r.push(i);return r;}

/* ---------- speech out ---------- */
function pickVoice(){
  try{
    const vs=speechSynthesis.getVoices();
    voiceKo=vs.find(x=>/^ko/i.test(String(x.lang).replace('_','-')))||null;
  }catch(e){}
}
if('speechSynthesis' in window){pickVoice();try{speechSynthesis.onvoiceschanged=pickVoice;}catch(e){}}
function cancelSpeak(){try{if('speechSynthesis' in window)speechSynthesis.cancel();}catch(e){}}
function speak(text){
  if(!('speechSynthesis' in window))return;
  try{
    speechSynthesis.cancel();
    const u=new SpeechSynthesisUtterance(text);
    u.lang='ko-KR';if(voiceKo)u.voice=voiceKo;
    u.rate=SET.slow?0.78:1;
    speechSynthesis.speak(u);
  }catch(e){}
}

/* ---------- build question items ---------- */
function intro(words){
  const a=num('age'),f=num('family'),m=num('months');
  const age=a==null?'○○ 살':(words?native(a)+' 살':a+'살');
  const fam=f==null?'○○ 명':(words?native(f)+' 명':f+'명');
  const mon=m==null?'○○개월':(words?sino(m):m)+'개월';
  return '안녕하십니까? 제 이름은 '+(v('name')||'○○')+'입니다. 제 나이는 '+age+'입니다. 저는 '+(v('country')||'○○')+' 사람입니다. 한국어를 배운 지 '+mon+' 됐습니다. '+(v('hometown')||'○○')+'에서 왔습니다. 제 가족은 '+fam+'이 있습니다. 저는 건강하고 책임감이 높고 모든 것이 빨리 배울 수 있는 사람입니다. 한국에 일하러 갈 기회가 있으면 열심히 일을 할 겁니다. 앞으로 잘 부탁드립니다. 만나서 반갑습니다. 감사합니다.';
}

function interview(n){
  const id='q'+n;
  const mk=(ko,say,th,ans,ansTh,o)=>{
    o=o||{};
    return{id:id,deck:'interview',n:n,ko:ko,say:say,th:th,answers:o.missing?[]:ans,ansKo:ans[0],ansTh:ansTh,missing:!!o.missing,big:o.big||null,long:!!o.long};
  };
  const nm=v('name')||'○○';
  const day=off=>{const d=new Date();d.setDate(d.getDate()+off);return d;};
  switch(n){
    case 0:{
      const miss=!v('name')||num('age')==null||num('family')==null||num('months')==null||!v('hometown')||!v('country');
      return mk('자기소개를 해 주세요.','자기소개를 해 주세요.','แนะนำตัวเอง',[intro(true),intro(false)],
        'สวัสดีครับ ผมชื่อ '+(v('name')||'○○')+' อายุ '+(v('age')||'○○')+' ปี เป็นคน'+(v('country')==='태국'?'ไทย':(v('country')||'○○'))+' เรียนภาษาเกาหลีมา '+(v('months')||'○○')+' เดือน มาจาก '+(v('hometown')||'○○')+' ครอบครัวมี '+(v('family')||'○○')+' คน ผมเป็นคนแข็งแรง รับผิดชอบสูง และเรียนรู้ทุกอย่างได้เร็ว ถ้ามีโอกาสไปทำงานที่เกาหลีจะทำงานอย่างขยันขันแข็ง ฝากตัวด้วยครับ ยินดีที่ได้พบ ขอบคุณครับ',
        {missing:miss,long:true});
    }
    case 1:
      return mk('성함이 어떻게 되세요? / 이름이 무엇입니까?','성함이 어떻게 되세요?','ชื่ออะไร (ชื่อของคุณคืออะไร)',
        ['제 이름이 '+nm+'입니다.','제 이름은 '+nm+'입니다.'],'ผมชื่อ '+(v('name')||'○○'),{missing:!v('name')});
    case 2:{
      const a=num('age');
      return mk('나이가 몇 살입니까?','나이가 몇 살입니까?','อายุเท่าไร',
        a==null?['제 나이가 ○○살입니다.']:['제 나이가 '+native(a)+' 살입니다.','제 나이가 '+a+'살입니다.'],
        'ผมอายุ '+(a==null?'○○':a)+' ปี',{missing:a==null});
    }
    case 3:{
      const Y=num('birthY'),M=num('birthM'),D=num('birthD');
      const bad=Y==null||M==null||D==null||M<1||M>12||D<1||D>31||Y<1900||Y>2100;
      return mk('생일이 언제입니까?','생일이 언제입니까?','วันเกิดคือเมื่อไร',
        bad?['제 생일이 ○○○○년 ○월 ○일입니다.']:['제 생일이 '+sino(Y)+'년 '+monthKo(M)+' '+sino(D)+'일입니다.','제 생일이 '+Y+'년 '+M+'월 '+D+'일입니다.'],
        'วันเกิดของผมคือวันที่ '+(bad?'○':D)+' '+(bad?'○○':TH_MONTHS[M-1])+' '+(bad?'○○○○':Y),{missing:bad});
    }
    case 4:{
      const yes=v('married')==='yes';
      return mk('결혼했습니까?','결혼했습니까?','แต่งงานแล้วหรือยัง',
        yes?['네, 결혼했습니다.']:['아닙니다, 아직 결혼 안 했습니다.','아니요, 아직 결혼 안 했습니다.'],
        yes?'ครับ แต่งงานแล้ว':'ไม่ครับ ยังไม่ได้แต่งงาน');
    }
    case 5:{
      const yes=v('kids')==='yes';
      return mk('아이가 있습니까?','아이가 있습니까?','มีลูกไหม',
        yes?['네, 있습니다.']:['아닙니다, 없습니다.','아니요, 없습니다.'],
        yes?'ครับ มีลูกแล้ว':'ไม่ครับ ยังไม่มี');
    }
    case 6:{
      const f=num('family');
      return mk('가족이 몇 명입니까?','가족이 몇 명입니까?','ครอบครัวมีกี่คน',
        f==null?['제 가족이 ○○명입니다.']:['제 가족이 '+native(f)+' 명입니다.','제 가족이 '+f+'명입니다.'],
        'ครอบครัวของผมมี '+(f==null?'○○':f)+' คน',{missing:f==null});
    }
    case 7:{
      const s=num('siblings');
      if(s===0)return mk('형제가 몇 명입니까?','형제가 몇 명입니까?','มีพี่น้องกี่คน',['제 형제가 없습니다.','저는 형제가 없습니다.'],'ผมไม่มีพี่น้อง');
      return mk('형제가 몇 명입니까?','형제가 몇 명입니까?','มีพี่น้องกี่คน',
        s==null?['제 형제가 ○○명입니다.']:['제 형제가 '+native(s)+' 명입니다.','제 형제가 '+s+'명입니다.'],
        'ผมมีพี่น้อง '+(s==null?'○○':s)+' คน',{missing:s==null});
    }
    case 8:{
      const h=num('height');
      return mk('키가 몇 센티미터입니까?','키가 몇 센티미터입니까?','สูงกี่เซนติเมตร',
        h==null?['제 키가 ○○센티미터입니다.']:['제 키가 '+sino(h)+' 센티미터입니다.','제 키가 '+h+' 센티미터입니다.'],
        'ผมสูง '+(h==null?'○○':h)+' เซนติเมตร',{missing:h==null});
    }
    case 9:{
      const w=num('weight');
      return mk('몸무게가 몇 킬로그램입니까?','몸무게가 몇 킬로그램입니까?','น้ำหนักกี่กิโลกรัม',
        w==null?['제 몸무게가 ○○킬로그램입니다.']:['제 몸무게가 '+sino(w)+' 킬로그램입니다.','제 몸무게가 '+w+' 킬로그램입니다.'],
        'ผมหนัก '+(w==null?'○○':w)+' กิโลกรัม',{missing:w==null});
    }
    case 10:{
      const T=new Date(),h=T.getHours()%12||12,mi=T.getMinutes();
      const full=mi?['지금 '+native(h)+' 시 '+sino(mi)+' 분입니다.','지금 '+h+'시 '+mi+'분입니다.']:['지금 '+native(h)+' 시입니다.','지금 '+h+'시입니다.'];
      const hourOnly=mi?['지금 '+native(h)+' 시입니다.','지금 '+h+'시입니다.']:[];
      return mk('지금 몇 시입니까?','지금 몇 시입니까?','ตอนนี้กี่โมง',full.concat(hourOnly),
        'ตอนนี้ '+h+' นาฬิกา'+(mi?' '+mi+' นาที':''));
    }
    case 11:case 12:case 13:{
      const off=n===11?0:n===12?1:-1,w=n===11?'오늘은':n===12?'내일은':'어제는',tw=n===11?'วันนี้':n===12?'พรุ่งนี้':'เมื่อวาน';
      const d=day(off).getDay();
      return mk(w+' 무슨 요일입니까?',w+' 무슨 요일입니까?',tw+'วันอะไร',[w+' '+DAYS[d]+'요일입니다.'],tw+'วัน'+TH_DAYS[d]);
    }
    case 14:case 15:case 16:{
      const off=n===14?0:n===15?1:-1,w=n===14?'오늘은':n===15?'내일은':'어제는',tw=n===14?'วันนี้':n===15?'พรุ่งนี้':'เมื่อวาน';
      const d=day(off),m=d.getMonth()+1,dd=d.getDate();
      return mk(w+' 몇 월 며칠입니까?',w+' 몇 월 며칠입니까?',tw+'วันที่เท่าไร เดือนอะไร',
        [w+' '+monthKo(m)+' '+sino(dd)+'일입니다.',w+' '+m+'월 '+dd+'일입니다.'],tw+'วันที่ '+dd+' '+TH_MONTHS[m-1]);
    }
    case 17:{
      const x=1+rand(100);
      return mk('숫자가 얼마입니까?','숫자가 얼마입니까?','ตัวเลขนี้คือเท่าไร',['숫자가 '+sino(x)+'입니다.','숫자가 '+x+'입니다.'],'ตัวเลขคือ '+x,{big:String(x)});
    }
    case 18:{
      const ops=[{w:'더하기',s:'+'},{w:'빼기',s:'−'},{w:'곱하기',s:'×'},{w:'나누기',s:'÷'}];
      const op=ops[rand(4)];let a,b,r;
      if(op.s==='+'){a=1+rand(20);b=1+rand(20);r=a+b;}
      else if(op.s==='−'){a=5+rand(26);b=1+rand(a-1);r=a-b;}
      else if(op.s==='×'){a=2+rand(8);b=2+rand(8);r=a*b;}
      else{b=2+rand(8);r=2+rand(8);a=b*r;}
      const q=sino(a)+' '+op.w+' '+josa(sino(b),'은','는')+' 얼마입니까?';
      return mk(q,q,'ช่วยคำนวณตัวเลขต่อไปนี้',[sino(r)+'입니다.',r+'입니다.'],'คำตอบคือ '+r,{big:a+' '+op.s+' '+b+' = ?'});
    }
    case 19:
      return mk('어디에서 왔습니까?','어디에서 왔습니까?','มาจากที่ไหน',[(v('hometown')||'○○')+'에서 왔습니다.'],'ผมมาจาก '+(v('hometown')||'○○'),{missing:!v('hometown')});
    case 20:
      return mk('어디에서 삽니까?','어디에서 삽니까?','อาศัยอยู่ที่ไหน',[(v('home')||'○○')+'에서 삽니다.'],'ผมอาศัยอยู่ที่ '+(v('home')||'○○'),{missing:!v('home')});
    default:{
      const s=ST[n];
      return mk(s[0],s[4]||s[0],s[1],s[2],s[3]);
    }
  }
}

function build(ref){
  if(ref.deck==='motion'){
    const d=MOTION[ref.n-1];
    return{id:'m'+ref.n,deck:'motion',n:ref.n,ko:d[0],say:d[1],th:d[2],answers:ACK,ansKo:'네, 알겠습니다.',ansTh:'ครับ เข้าใจแล้ว — แล้วทำท่า: '+d[2],big:null,long:false};
  }
  if(ref.deck==='tools'){
    const d=TOOLS[ref.n-1],sp=TSPEC[ref.n-1];
    let say=d[1],th=d[2],params={};
    if(sp.act==='bend'){
      const bend=Math.random()<0.5,mode=bend?'bend':'straighten';
      say='플라이어를 가져와서 철사를 '+(bend?'구부리는':'펴는')+' 행동하세요.';
      th=bend?'เอาคีมมา แล้วทำท่างอลวดเหล็ก':'เอาคีมมา แล้วทำท่ายืดลวดเหล็กให้ตรง';
      params={mode:mode,y0:bend?120:120+(Math.random()<0.5?-1:1)*(48+rand(14))};
    }else if(sp.act==='extend'&&sp.kind==='caliper'){
      const mm=25+rand(30),L=mm*3;
      params={x0:290,min:76,max:290,len:L,target:76+L,reading:'ความยาว ≈ '+mm+' มม.'};
    }else if(sp.act==='extend'){
      const cm=12+rand(14),L=cm*8;
      params={x0:60,min:60,max:300,len:L,target:60+L,reading:'ความยาว ≈ '+cm+' ซม.'};
    }
    return{id:'t'+ref.n,deck:'tools',n:ref.n,ko:d[0],say:say,th:th,answers:ACK,ansKo:'네, 알겠습니다.',ansTh:'ครับ เข้าใจแล้ว — แล้วทำท่า: '+th,big:null,long:false,spec:sp,params:params};
  }
  return interview(ref.n);
}

/* ---------- sessions ---------- */
function refFromId(id){
  const n=parseInt(id.slice(1),10);
  return{deck:id[0]==='m'?'motion':id[0]==='t'?'tools':'interview',n:n};
}
function startSession(kind){
  let list=[],title='',exam=false;
  const M=n=>({deck:'motion',n:n}),T=n=>({deck:'tools',n:n}),Q=n=>({deck:'interview',n:n});
  if(kind==='motion'){list=range(1,21).map(M);title='คำสั่งขยับตัว';}
  else if(kind==='tools'){list=range(1,11).map(T);title='เครื่องมือ';}
  else if(kind==='interview'){list=range(0,41).map(Q);title='สัมภาษณ์';}
  else if(kind==='mix'){
    exam=true;title='ซ้อมสอบผสม';
    const rest=shuffle(shuffle(range(1,21)).slice(0,3).map(M).concat(shuffle(range(1,11)).slice(0,2).map(T),shuffle(range(1,41)).slice(0,8).map(Q)));
    list=[Q(0)].concat(rest);
  }
  else if(kind==='review'){
    list=Object.keys(wrong).map(refFromId);title='ข้อที่ต้องซ้อมอีก';
  }
  if(!list.length)return;
  if(SET.shuffle&&!exam)shuffle(list);
  sess={kind:kind,title:title,list:list,i:0,exam:exam,started:Date.now(),log:[],cur:null,bench:{tools:shuffle(TSPEC.map(s=>s.tool)),mats:shuffle(BENCH_MAT.map(m=>m.id))}};
  present();
}
function present(){
  stopMic(true);
  sess.cur=build(sess.list[sess.i]);
  ui={phase:'ask',showTh:false,peek:false,msg:'',res:null,stage:'ack',wrong:0,hint:false,ackText:'',ackOk:null};
  view='session';render();window.scrollTo(0,0);
  speak(sess.cur.say);
}
function finish(){stopMic(true);cancelSpeak();view='summary';render();window.scrollTo(0,0);}
function saveProgress(){store.set('eps_passed',passed);store.set('eps_wrong',wrong);}

/* ---------- speech in ---------- */
function stopMic(abort){
  if(mic&&mic.rec){try{mic.rec.onend=null;mic.rec.onerror=null;mic.rec.onresult=null;if(abort)mic.rec.abort();else mic.rec.stop();}catch(e){}}
  mic=null;
}
function updateLive(){
  const el=document.getElementById('live');
  if(el&&mic)el.textContent=(mic.final+' '+mic.interim).trim();
}
function startMic(){
  cancelSpeak();
  if(!SRC){ui.msg='เบราว์เซอร์นี้ยังไม่รองรับการฟังเสียง ลองใช้ Chrome หรือ Safari เวอร์ชันล่าสุด หรือพิมพ์คำตอบแทน';render();return;}
  const r=new SRC();
  r.lang='ko-KR';r.interimResults=true;r.continuous=!!sess.cur.long;r.maxAlternatives=1;
  const m={on:true,rec:r,final:'',interim:'',err:''};
  mic=m;
  r.onresult=ev=>{
    let f='',i='';
    for(let k=0;k<ev.results.length;k++){const x=ev.results[k];if(x.isFinal)f+=x[0].transcript+' ';else i+=x[0].transcript;}
    m.final=f.trim();m.interim=i;updateLive();
  };
  r.onerror=ev=>{m.err=ev.error||'error';};
  r.onend=()=>{m.on=false;if(mic===m)afterMic(m);};
  try{r.start();ui.msg='';}catch(e){m.on=false;mic=null;ui.msg='เริ่มไมค์ไม่ได้ ลองแตะอีกครั้ง';}
  render();
}
function afterMic(m){
  const text=(m.final+' '+m.interim).trim();
  mic=null;
  if(m.err==='not-allowed'||m.err==='service-not-allowed'){
    ui.msg='ไมค์ถูกบล็อก — อนุญาตให้เบราว์เซอร์ใช้ไมค์ หรือเปิดไฟล์นอกหน้าพรีวิว ตอนนี้พิมพ์คำตอบแทนได้';render();return;
  }
  if(!text){
    ui.msg=(!m.err||m.err==='no-speech')?'ไม่ได้ยินเสียง ลองแตะไมค์แล้วพูดอีกครั้ง':'ไมค์ผิดพลาด ('+m.err+') ลองอีกครั้งหรือพิมพ์คำตอบ';
    render();return;
  }
  answer(text);
}
function answer(text){
  const it=sess.cur;let score=null,ack=null;
  if(it.deck==='tools'){
    ui.ackText=text;
    ui.ackOk=Math.max.apply(null,ACK.map(a=>sim(a,text)))>=0.6||/알겠/.test(text);
    ui.stage='pick';ui.msg='';render();return;
  }
  if(it.deck==='interview'){
    if(it.answers.length){score=0;it.answers.forEach(a=>{score=Math.max(score,sim(a,text));});}
  }else{
    score=Math.max.apply(null,ACK.map(a=>sim(a,text)));
    ack=score>=0.6||/알겠/.test(text);
  }
  ui.phase='answered';ui.res={text:text,score:score,ack:ack};ui.msg='';
  render();
}

/* ---------- views ---------- */
const I={
  back:'<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>',
  spk:'<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/><path d="M16.5 8.5a5 5 0 010 7M19 6a8.5 8.5 0 010 12"/></svg>',
  mic:'<svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3" fill="currentColor"/><path d="M5 11a7 7 0 0014 0M12 18v3"/></svg>',
  stop:'<svg width="32" height="32" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2" fill="currentColor"/></svg>'
};

function render(){
  if(view==='home')$app.innerHTML=renderHome();
  else if(view==='session')$app.innerHTML=renderSession();
  else if(view==='summary')$app.innerHTML=renderSummary();
  else if(view==='setup')$app.innerHTML=renderSetup();
  else if(view==='vocab')$app.innerHTML=renderVocab();
  updateLive();
  afterRender();
}

function countPassed(p,total){
  let c=0;Object.keys(passed).forEach(k=>{if(k[0]===p)c++;});
  return{c:Math.min(c,total),total:total};
}
function deckRow(k,glyph,name,meta,pr){
  const bar=pr?'<div class="track"><i style="width:'+Math.round(pr.c/pr.total*100)+'%"></i></div>':'';
  return '<button class="deck" data-a="start" data-k="'+k+'"><div class="emblem" aria-hidden="true">'+glyph+'</div><div class="deck-main"><div class="deck-name">'+name+'</div><div class="deck-meta">'+meta+(pr?' · ผ่านแล้ว '+pr.c+'/'+pr.total:'')+'</div>'+bar+'</div></button>';
}
function renderHome(){
  const miss=REQ.filter(k=>!v(k)).length;
  const wn=Object.keys(wrong).length;
  let h='<h1 class="home-title">ซ้อมสอบทักษะ EPS</h1><p class="home-sub">ฟังคำถามภาษาเกาหลี แล้วตอบด้วยเสียงของคุณเอง</p>';
  if(!SRC)h+='<div class="note">เบราว์เซอร์นี้ไม่รองรับการฟังเสียง ลองใช้ Chrome หรือ Safari เวอร์ชันล่าสุด ตอนนี้ยังตอบด้วยการพิมพ์ได้</div>';
  if(miss)h+='<div class="note calm">ยังไม่ได้กรอกข้อมูลของฉัน '+miss+' ช่อง (ชื่อ อายุ วันเกิด ฯลฯ) — กรอกก่อนเพื่อให้ตรวจคำตอบข้อแนะนำตัวได้ตรง</div>';
  h+='<div class="seg" role="group" aria-label="ลำดับข้อ"><button data-a="order" data-v="0" aria-pressed="'+(!SET.shuffle)+'">เรียงตามชีท</button><button data-a="order" data-v="1" aria-pressed="'+SET.shuffle+'">สุ่มข้อ</button></div>';
  h+=deckRow('motion','손','คำสั่งขยับตัว','21 ข้อ',countPassed('m',21));
  h+=deckRow('tools','못','เครื่องมือ','11 ข้อ · โต๊ะช่างจำลอง ลงมือทำจริง',countPassed('t',11));
  h+=deckRow('interview','말','สัมภาษณ์','แนะนำตัว + 41 ข้อ',countPassed('q',42));
  h+=deckRow('mix','실','ซ้อมสอบผสม','14 ข้อ สุ่ม ซ่อนข้อความเกาหลี',null);
  h+='<div class="links">';
  if(wn)h+='<button class="chip" data-a="start" data-k="review">ข้อที่ต้องซ้อมอีก ('+wn+')</button>';
  h+='<button class="chip" data-a="vocab">คำศัพท์เครื่องมือ</button><button class="chip" data-a="setup">ข้อมูลของฉัน</button></div>';
  h+='<h3>ตัวเลือก</h3><div class="links"><button class="chip" data-a="opt" data-k="slow" aria-pressed="'+SET.slow+'">พูดช้าลง</button><button class="chip" data-a="opt" data-k="hideKo" aria-pressed="'+SET.hideKo+'">ซ่อนตัวอักษรเกาหลี (ฟังอย่างเดียว)</button></div>';
  if(!store.persistent)h+='<p class="small">หน้าตัวอย่างนี้ยังบันทึกความคืบหน้าข้ามการเปิดแอปไม่ได้ จะบันทึกได้เมื่อนำไปวางบนเว็บ</p>';
  return h;
}

function renderSession(){
  if(sess.cur.deck==='tools')return renderTools();
  const it=sess.cur,total=sess.list.length;
  const hidden=(SET.hideKo||sess.exam)&&!ui.peek&&ui.phase==='ask';
  const task=it.deck==='interview'?'ฟังคำถาม แล้วตอบเป็นภาษาเกาหลี':it.deck==='motion'?'ฟังคำสั่ง ทำท่าตาม แล้วพูดว่า 네, 알겠습니다':'ฟังคำสั่ง ทำท่าใช้เครื่องมือ แล้วพูดว่า 네, 알겠습니다';
  let h='<div class="top"><button class="icon-btn" data-a="home" aria-label="กลับหน้าแรก">'+I.back+'</button><div class="top-title">'+esc(sess.title)+'</div><div class="top-count">'+(sess.i+1)+'/'+total+'</div></div>';
  h+='<div class="prog"><i style="width:'+Math.round(sess.i/total*100)+'%"></i></div>';
  h+='<p class="task">'+task+'</p>';
  h+=hidden?'<div class="q quiet">ฟังแล้วตอบ (ตัวอักษรถูกซ่อนไว้)</div>':'<div class="q">'+esc(it.ko)+'</div>';
  if(it.big)h+='<div class="bigcard" aria-label="ตัวเลขที่ผู้สอบถือให้ดู">'+esc(it.big)+'</div>';
  h+='<div class="tools-row"><button class="chip" data-a="replay">'+I.spk+' ฟังอีกครั้ง</button><button class="chip" data-a="slow" aria-pressed="'+SET.slow+'">พูดช้า</button>';
  if(hidden)h+='<button class="chip" data-a="peek">ดูตัวอักษร</button>';
  if(ui.phase==='ask'&&!sess.exam&&!ui.showTh)h+='<button class="chip" data-a="showth">ดูความหมาย</button>';
  h+='</div>';
  if(ui.showTh&&ui.phase==='ask')h+='<div class="thbox">'+esc(it.th)+'</div>';

  if(ui.phase==='ask'){
    const on=mic&&mic.on;
    const live=mic?(mic.final+' '+mic.interim).trim():'';
    h+='<div class="mic-wrap"><button class="mic'+(on?' on':'')+'" data-a="mic" aria-label="'+(on?'หยุดฟัง':'เริ่มพูด')+'">'+(on?I.stop:I.mic)+'</button><div class="mic-label">'+(on?'กำลังฟัง… แตะเพื่อหยุด':'แตะเพื่อพูดตอบ')+'</div></div>';
    h+='<div class="live" id="live" aria-live="polite">'+esc(live)+'</div>';
    if(ui.msg)h+='<div class="note">'+esc(ui.msg)+'</div>';
    if(it.deck==='interview'){
      h+='<div class="alt-row"><input class="input" id="typed" placeholder="หรือพิมพ์คำตอบเป็นฮันกึล" autocomplete="off" autocapitalize="off"><button class="btn" data-a="typed">ส่ง</button></div>';
    }else{
      h+='<div class="alt-row"><button class="btn block" data-a="done">พูดและทำท่าแล้ว (ไม่ใช้ไมค์)</button></div>';
    }
    h+='<button class="linkbtn" data-a="skip">ยังตอบไม่ได้ ดูเฉลย</button>';
  }else{
    const r=ui.res;
    if(r){
      let pill='';
      if(it.deck==='interview'){
        if(r.score==null)pill='<span class="pill mid">ยังตรวจอัตโนมัติไม่ได้ — กรอกข้อมูลของฉันก่อน</span>';
        else{
          const hi=it.long?0.75:0.85,mid=it.long?0.5:0.6,p=Math.round(r.score*100);
          pill=r.score>=hi?'<span class="pill good">ตรงกับตัวอย่าง '+p+'%</span>':r.score>=mid?'<span class="pill mid">ใกล้เคียง '+p+'%</span>':'<span class="pill low">ยังต่างจากตัวอย่าง '+p+'%</span>';
        }
      }else{
        pill=r.ack?'<span class="pill good">ได้ยินคำว่า 알겠습니다</span>':'<span class="pill low">ไม่ได้ยินคำว่า 알겠습니다</span>';
      }
      h+='<div class="result"><div class="small">คุณพูดว่า</div><div class="said">'+esc(r.text)+'</div>'+pill+'</div>';
    }
    h+='<div class="model"><div class="ko">'+esc(it.ansKo)+'</div><div class="th">'+esc(it.ansTh)+'</div><div class="th">คำถามหมายถึง: '+esc(it.th)+'</div><button class="chip" data-a="hear">'+I.spk+' ฟังตัวอย่าง</button>';
    if(it.missing)h+='<div class="note calm" style="margin-top:10px">ตัวอย่างนี้ใช้ข้อมูลของคุณ ใส่ข้อมูลในหน้า “ข้อมูลของฉัน” แล้วจะตรงกับคุณ</div>';
    h+='</div>';
    h+='<div class="rate"><button class="btn bad" data-a="rate" data-v="0">ต้องซ้อมอีก</button><button class="btn good" data-a="rate" data-v="1">ตอบได้แล้ว</button></div>';
  }
  return h;
}

function micBlock(){
  const on=mic&&mic.on,live=mic?(mic.final+' '+mic.interim).trim():'';
  let h='<div class="mic-wrap"><button class="mic'+(on?' on':'')+'" data-a="mic" aria-label="'+(on?'หยุดฟัง':'เริ่มพูด')+'">'+(on?I.stop:I.mic)+'</button><div class="mic-label">'+(on?'กำลังฟัง… แตะเพื่อหยุด':'แตะเพื่อพูดตอบ')+'</div></div>';
  h+='<div class="live" id="live" aria-live="polite">'+esc(live)+'</div>';
  if(ui.msg)h+='<div class="note">'+esc(ui.msg)+'</div>';
  return h;
}

function donePanel(it){
  const sp=it.spec;
  const wd=a=>'<div class="wd"><b>'+esc(a[0])+'</b><small>'+esc(a[1])+'</small></div>';
  let h='<div class="model"><div class="ok-title">✓ ทำเสร็จแล้ว</div>';
  h+='<div class="seg-row">'+wd(sp.tp)+wd(['가져 와서','เอามา แล้ว'])+wd(sp.op)+wd(sp.vp)+wd(['행동하세요','ทำท่า'])+'</div>';
  h+='<div class="th">'+esc(it.th)+'</div>';
  h+='<div class="pills">'+(ui.wrong?'<span class="pill low">เลือกเครื่องมือผิด '+ui.wrong+' ครั้ง</span>':'<span class="pill good">เลือกเครื่องมือถูกตั้งแต่ครั้งแรก</span>');
  if(ui.ackText)h+='<span class="pill '+(ui.ackOk?'good':'low')+'">'+(ui.ackOk?'ได้ยินคำว่า 알겠습니다':'ไม่ได้ยินคำว่า 알겠습니다')+'</span>';
  h+='</div><button class="chip" data-a="hearcmd">'+I.spk+' ฟังคำสั่งอีกครั้ง</button></div>';
  h+='<div class="rate"><button class="btn bad" data-a="rate" data-v="0">ต้องซ้อมอีก</button><button class="btn good" data-a="rate" data-v="1">ผ่านแล้ว ข้อต่อไป</button></div>';
  return h;
}

function renderTools(){
  const it=sess.cur,sp=it.spec,total=sess.list.length,st=ui.stage;
  const hidden=(SET.hideKo||sess.exam)&&!ui.peek&&st!=='done';
  const idx={ack:0,pick:1,act:2,done:3}[st];
  const cls=i=>i<idx?'ok':i===idx?'on':'';
  let h='<div class="top"><button class="icon-btn" data-a="home" aria-label="กลับหน้าแรก">'+I.back+'</button><div class="top-title">'+esc(sess.title)+'</div><div class="top-count">'+(sess.i+1)+'/'+total+'</div></div>';
  h+='<div class="prog"><i style="width:'+Math.round(sess.i/total*100)+'%"></i></div>';
  h+='<div class="steps"><span class="'+cls(0)+'">1 พูดรับคำสั่ง</span><span class="'+cls(1)+'">2 หยิบของบนโต๊ะ</span><span class="'+cls(2)+'">3 ลงมือทำ</span></div>';
  h+=hidden?'<div class="q quiet">ฟังแล้วทำตาม (ตัวอักษรถูกซ่อนไว้)</div>':'<div class="q">'+esc(it.ko)+'</div>';
  h+='<div class="tools-row"><button class="chip" data-a="replay">'+I.spk+' ฟังอีกครั้ง</button><button class="chip" data-a="slow" aria-pressed="'+SET.slow+'">พูดช้า</button>';
  if(hidden)h+='<button class="chip" data-a="peek">ดูตัวอักษร</button>';
  if(st!=='done'&&!sess.exam&&!ui.showTh)h+='<button class="chip" data-a="showth">ดูความหมาย</button>';
  h+='</div>';
  if(ui.showTh&&st!=='done')h+='<div class="thbox">'+esc(it.th)+'</div>';

  if(st==='ack'){
    h+='<p class="task" style="text-align:center">พูดว่า <b>네, 알겠습니다</b> ก่อน แล้วค่อยไปหยิบของที่โต๊ะ</p>'+micBlock();
    h+='<button class="linkbtn" data-a="skipack">ข้ามการพูด ไปที่โต๊ะเลย</button>';
  }else if(st==='pick'){
    const labels=!(SET.hideKo||sess.exam)||ui.peek;
    h+='<svg id="bench" class="scene" viewBox="0 0 360 400" role="img" aria-label="โต๊ะช่าง มีวัสดุด้านบนและเครื่องมือบนชั้นด้านล่าง">'+benchSvg(sess.bench,labels)+'</svg>';
    h+='<p class="act-hint">ลากเครื่องมือจากชั้นด้านล่างไปวางบนวัสดุที่คำสั่งบอก</p><p class="act-hint" id="actmsg"></p>';
  }else{
    const sc=SC[sp.act];
    h+='<div class="note calm" style="display:flex;align-items:center;gap:10px">'+tIcon(sp.tool,32)+'<span>ในมือ: <b>'+esc(shortName(sp.toolKo))+'</b> · ใช้กับ <b>'+esc(shortName(sp.op[0]))+'</b></span></div>';
    h+='<svg id="scene" class="scene" viewBox="0 0 320 200" role="img" aria-label="พื้นที่ลงมือทำ">'+sc.svg(it)+'</svg>';
    if(sc.extra)h+=sc.extra;
    h+='<p class="act-hint" id="acthint">'+(st==='done'?'เยี่ยม! ทำเสร็จแล้ว':esc(sc.hint(it)))+'</p><p class="act-hint" id="actmsg"></p>';
    h+='<div id="donepanel"'+(st==='done'?'':' hidden')+'>'+donePanel(it)+'</div>';
  }
  return h;
}

function sceneDone(){
  ui.stage='done';
  const p=document.getElementById('donepanel');
  if(p){p.hidden=false;setTimeout(()=>{try{p.scrollIntoView({behavior:'smooth',block:'nearest'});}catch(e){}},150);}
  document.querySelectorAll('.steps span').forEach(x=>{x.className='ok';});
  const hint=document.getElementById('acthint');if(hint)hint.textContent='เยี่ยม! ทำเสร็จแล้ว';
}
function benchDone(){ui.stage='act';ui.msg='';render();}
function afterRender(){
  if(!(view==='session'&&sess&&sess.cur&&sess.cur.deck==='tools'))return;
  if(ui.stage==='pick'){const b=document.getElementById('bench');if(b)mountBench(b,sess.cur,benchDone);}
  else if(ui.stage==='act'){const svg=document.getElementById('scene');if(svg)SC[sess.cur.spec.act].mount(svg,sess.cur,sceneDone);}
}

function renderSummary(){
  const secs=Math.round((Date.now()-sess.started)/1000),mm=Math.floor(secs/60),ss=String(secs%60).padStart(2,'0');
  const good=sess.log.filter(x=>x.good).length,bad=sess.log.length-good;
  let h='<h2>เสร็จแล้ว</h2><p class="home-sub">'+esc(sess.title)+'</p>';
  h+='<div class="stat"><div><b>'+good+'</b>ตอบได้</div><div><b>'+bad+'</b>ต้องซ้อมอีก</div><div><b>'+mm+':'+ss+'</b>เวลารวม</div></div>';
  h+='<div>';
  sess.log.slice().sort((a,b)=>a.good-b.good).forEach(x=>{
    h+='<div class="logrow"><span class="dot '+(x.good?'good':'bad')+'" aria-label="'+(x.good?'ตอบได้':'ต้องซ้อมอีก')+'">'+(x.good?'✓':'!')+'</span><div>'+esc(x.ko)+'</div></div>';
  });
  h+='</div><div style="display:grid;gap:10px;margin-top:18px">';
  if(Object.keys(wrong).length)h+='<button class="btn primary" data-a="start" data-k="review">ซ้อมเฉพาะข้อที่ต้องซ้อมอีก</button>';
  h+='<button class="btn" data-a="home">กลับหน้าแรก</button></div>';
  return h;
}

function renderSetup(){
  const F=(k,label,hint,mode)=>'<label class="field"><span>'+label+'</span><input class="input" data-f="'+k+'" value="'+esc(P[k])+'" autocomplete="off"'+(mode==='n'?' inputmode="numeric"':'')+'>'+(hint?'<small>'+hint+'</small>':'')+'</label>';
  const S=(k,label,opts)=>'<label class="field"><span>'+label+'</span><select class="input" data-f="'+k+'">'+opts.map(o=>'<option value="'+o[0]+'"'+(P[k]===o[0]?' selected':'')+'>'+o[1]+'</option>').join('')+'</select></label>';
  let h='<div class="top"><button class="icon-btn" data-a="home" aria-label="กลับหน้าแรก">'+I.back+'</button><div class="top-title">ข้อมูลของฉัน</div></div>';
  h+='<p class="small">ใช้เติมคำตอบตัวอย่างข้อแนะนำตัวและข้อ 1-9, 19-20 ข้อมูลจะอยู่ในเครื่องของคุณเท่านั้น</p>';
  h+=F('name','ชื่อ (ฮันกึล)','เช่น 알렉스 — ถ้ายังพิมพ์ฮันกึลไม่ได้ ให้ถามผมในแชทแล้วผมจะเขียนให้');
  h+=F('age','อายุ (ปี)','','n');
  h+=F('country','สัญชาติ (ฮันกึล)','เช่น 태국 (ไทย) 라오스 (ลาว)');
  h+=F('months','เรียนภาษาเกาหลีมากี่เดือน','','n');
  h+=F('birthY','ปีเกิด (ค.ศ.)','เช่น 1998','n');
  h+=F('birthM','เดือนเกิด (1-12)','','n');
  h+=F('birthD','วันที่เกิด (1-31)','','n');
  h+=S('married','แต่งงานแล้วหรือยัง',[['no','ยังไม่ได้แต่งงาน'],['yes','แต่งงานแล้ว']]);
  h+=S('kids','มีลูกไหม',[['no','ไม่มี'],['yes','มี']]);
  h+=F('family','สมาชิกในครอบครัว (คน)','','n');
  h+=F('siblings','จำนวนพี่น้อง (คน)','','n');
  h+=F('height','ส่วนสูง (ซม.)','','n');
  h+=F('weight','น้ำหนัก (กก.)','','n');
  h+=F('hometown','มาจากที่ไหน (ฮันกึล)','เช่น ชื่อจังหวัดหรืออำเภอเป็นอักษรเกาหลี');
  h+=F('home','อาศัยอยู่ที่ไหน (ฮันกึล)','');
  h+='<button class="btn primary block" data-a="home" style="margin-top:12px">บันทึกและกลับ</button>';
  return h;
}

function renderVocab(){
  let h='<div class="top"><button class="icon-btn" data-a="home" aria-label="กลับหน้าแรก">'+I.back+'</button><div class="top-title">คำศัพท์เครื่องมือ</div></div><p class="small">แตะแถวไหนก็ได้เพื่อฟังเสียงอ่าน</p>';
  VOCAB.forEach(g=>{
    h+='<h3>'+g[0]+'</h3>';
    g[1].forEach(r=>{h+='<button class="vrow" data-a="say" data-t="'+esc(r[0].split(' / ')[0])+'"><span class="k">'+esc(r[0])+'</span><span class="t">'+esc(r[1])+'</span></button>';});
  });
  return h;
}

/* ---------- events ---------- */
const A={
  start:t=>startSession(t.dataset.k),
  home:()=>{stopMic(true);cancelSpeak();view='home';render();window.scrollTo(0,0);},
  setup:()=>{view='setup';render();window.scrollTo(0,0);},
  vocab:()=>{view='vocab';render();window.scrollTo(0,0);},
  say:t=>speak(t.dataset.t),
  order:t=>{SET.shuffle=t.dataset.v==='1';store.set('eps_settings',SET);render();},
  opt:t=>{const k=t.dataset.k;SET[k]=!SET[k];store.set('eps_settings',SET);render();},
  slow:()=>{SET.slow=!SET.slow;store.set('eps_settings',SET);render();},
  replay:()=>{if(mic&&mic.on)return;speak(sess.cur.say);},
  hear:()=>speak(sess.cur.ansKo),
  peek:()=>{ui.peek=true;render();},
  showth:()=>{ui.showTh=true;render();},
  mic:()=>{if(mic&&mic.on){try{mic.rec.stop();}catch(e){}return;}startMic();},
  typed:()=>{const el=document.getElementById('typed');const t=el?el.value.trim():'';if(!t){ui.msg='พิมพ์คำตอบก่อนแล้วกดส่ง';render();return;}stopMic(true);cancelSpeak();answer(t);},
  done:()=>{stopMic(true);cancelSpeak();answer('(ทำท่าตามคำสั่งแล้ว)');ui.res={text:'(ทำท่าตามคำสั่งแล้ว ไม่ได้ใช้ไมค์)',score:null,ack:null};render();},
  skip:()=>{stopMic(true);cancelSpeak();ui.phase='answered';ui.res=null;ui.msg='';render();},
  skipack:()=>{stopMic(true);cancelSpeak();ui.stage='pick';ui.msg='';render();},
  hearcmd:()=>speak(sess.cur.say),
  rate:t=>{
    const good=t.dataset.v==='1',it=sess.cur;
    sess.log.push({id:it.id,ko:it.ko,good:good});
    if(good){passed[it.id]=1;delete wrong[it.id];}else{wrong[it.id]=1;delete passed[it.id];}
    saveProgress();cancelSpeak();
    if(sess.i+1>=sess.list.length)finish();else{sess.i++;present();}
  }
};
document.addEventListener('click',e=>{
  const t=e.target.closest('[data-a]');
  if(!t)return;
  const f=A[t.dataset.a];
  if(f)f(t);
});
document.addEventListener('input',e=>{
  const f=e.target&&e.target.dataset&&e.target.dataset.f;
  if(f){P[f]=e.target.value;store.set('eps_profile',P);}
});
document.addEventListener('keydown',e=>{
  if(e.key==='Enter'&&e.target&&e.target.id==='typed'){A.typed();}
});

render();

if(window.__EPS_TEST)window.__EPS_TEST={sino:sino,native:native,josa:josa,sim:sim,build:build,monthKo:monthKo,interview:interview,P:P,SC:SC,TSPEC:TSPEC,TICON:TICON,mountBench:mountBench,benchSvg:benchSvg,toolPos:toolPos,matPos:matPos,BENCH_MAT:BENCH_MAT,setSess:function(x){sess=x;},setUi:function(x){ui=x;}};
})();
</script>
</body>
</html>
