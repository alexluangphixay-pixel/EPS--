<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="ซ้อมสอบ EPS">
<meta name="theme-color" content="#1E4DA1">
<title>ซ้อมสอบทักษะ EPS</title>
<style>
:root{
  --bg:#EDF0F4; --surface:#FFFFFF; --ink:#172033; --muted:#566176; --line:#D3DAE5;
  --blue:#1E4DA1; --on-blue:#FFFFFF; --blue-soft:#DCE6F7;
  --red:#B8352D; --red-soft:#F8E0DD; --green:#1B7552; --green-soft:#D7EEE3;
  color-scheme: light dark;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#0F141D; --surface:#182131; --ink:#E8EDF5; --muted:#9FABBD; --line:#2C3749;
    --blue:#86AAF2; --on-blue:#0E1626; --blue-soft:#1E2D4B;
    --red:#F29088; --red-soft:#3A2220; --green:#6FCFA2; --green-soft:#183629;
  }
}
*{box-sizing:border-box}
html,body{margin:0}
body{
  background:var(--bg); color:var(--ink);
  font:16px/1.6 -apple-system,"Apple SD Gothic Neo","Noto Sans KR","Malgun Gothic","Thonburi","Noto Sans Thai",system-ui,sans-serif;
  -webkit-text-size-adjust:100%;
}
#app{max-width:520px;margin:0 auto;padding:16px 16px 48px;min-height:100vh}
button,input,select{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}

/* home */
.home-title{font-size:26px;font-weight:700;line-height:1.35;margin:12px 0 2px}
.home-sub{color:var(--muted);margin:0 0 16px}
.seg{display:flex;gap:4px;padding:4px;border-radius:12px;background:var(--blue-soft);margin-bottom:14px}
.seg button{flex:1;min-height:44px;border:0;border-radius:9px;background:transparent;font-weight:600;color:var(--muted)}
.seg button[aria-pressed="true"]{background:var(--surface);color:var(--ink)}
.deck{display:flex;align-items:center;gap:14px;width:100%;text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px;margin-bottom:10px}
.emblem{flex:none;width:56px;height:56px;border-radius:14px;background:var(--blue);color:var(--on-blue);display:grid;place-items:center;font-size:28px;font-weight:700}
.deck-main{flex:1;min-width:0}
.deck-name{font-weight:700}
.deck-meta{color:var(--muted);font-size:14px}
.track{height:6px;border-radius:3px;background:var(--blue-soft);margin-top:8px;overflow:hidden}
.track i{display:block;height:100%;background:var(--green)}
.links{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}
.chip{min-height:44px;padding:0 16px;border-radius:22px;border:1px solid var(--line);background:var(--surface);display:inline-flex;align-items:center;gap:8px;font-weight:600}
.chip[aria-pressed="true"]{background:var(--blue-soft);border-color:var(--blue)}
.note{background:var(--red-soft);border-radius:12px;padding:10px 12px;font-size:14px;margin:10px 0}
.note.calm{background:var(--blue-soft)}
.small{color:var(--muted);font-size:14px}

/* session */
.top{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.icon-btn{flex:none;width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--surface);display:grid;place-items:center}
.top-title{flex:1;font-weight:700}
.top-count{color:var(--muted);font-variant-numeric:tabular-nums}
.prog{height:4px;background:var(--blue-soft);border-radius:2px;overflow:hidden;margin-bottom:16px}
.prog i{display:block;height:100%;background:var(--blue)}
.task{color:var(--muted);font-size:14px;margin:0 0 8px}
.q{background:var(--surface);border:1px solid var(--line);border-left:6px solid var(--blue);border-radius:16px;padding:18px;font-size:28px;line-height:1.5;font-weight:600;word-break:keep-all}
.q.quiet{font-size:18px;font-weight:500;color:var(--muted)}
.bigcard{margin-top:10px;background:var(--surface);border:2px solid var(--ink);border-radius:12px;padding:12px;text-align:center;font-size:44px;font-weight:700;font-variant-numeric:tabular-nums}
.tools-row{display:flex;gap:8px;margin:10px 0;flex-wrap:wrap}
.thbox{background:var(--blue-soft);border-radius:12px;padding:10px 14px;margin:6px 0}
.mic-wrap{display:flex;flex-direction:column;align-items:center;margin:18px 0 10px}
.mic{position:relative;width:88px;height:88px;border-radius:50%;border:0;background:var(--blue);color:var(--on-blue);display:grid;place-items:center}
.mic.on{background:var(--red);color:#fff}
.mic.on::after{content:"";position:absolute;inset:-8px;border-radius:50%;border:3px solid var(--red);animation:ring 1.2s ease-out infinite}
@keyframes ring{from{transform:scale(.9);opacity:.6}to{transform:scale(1.25);opacity:0}}
@media (prefers-reduced-motion: reduce){.mic.on::after{animation:none;opacity:.5}}
.mic-label{margin-top:10px;color:var(--muted);font-size:14px}
.live{min-height:3.2em;background:var(--surface);border:1px dashed var(--line);border-radius:12px;padding:10px 12px;font-size:18px}
.alt-row{display:flex;gap:8px;margin:12px 0 4px}
.input{flex:1;min-width:0;min-height:48px;border-radius:12px;border:1px solid var(--line);background:var(--surface);padding:0 12px}
.linkbtn{background:none;border:0;color:var(--muted);text-decoration:underline;min-height:44px;padding:0 4px}
.btn{min-height:52px;border-radius:14px;border:1px solid var(--line);background:var(--surface);font-weight:700;padding:0 16px}
.btn.primary{background:var(--blue);border-color:var(--blue);color:var(--on-blue)}
.btn.good{background:var(--green-soft);border-color:var(--green);color:var(--green)}
.btn.bad{background:var(--red-soft);border-color:var(--red);color:var(--red)}
.btn.block{width:100%}
.result{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin:14px 0 0}
.result .said{font-size:20px;margin:2px 0 8px}
.pill{display:inline-block;border-radius:999px;padding:2px 12px;font-size:14px;font-weight:700}
.pill.good{background:var(--green-soft);color:var(--green)}
.pill.mid{background:var(--blue-soft);color:var(--blue)}
.pill.low{background:var(--red-soft);color:var(--red)}
.model{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:14px 16px;margin:12px 0}
.model .ko{font-size:21px;font-weight:600;line-height:1.55}
.model .th{color:var(--muted);margin:6px 0}
.rate{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}

/* summary, setup, vocab */
h2{font-size:22px;line-height:1.35;margin:8px 0 4px}
h3{font-size:16px;margin:20px 0 6px}
.stat{display:flex;gap:10px;margin:12px 0}
.stat div{flex:1;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px;text-align:center}
.stat b{display:block;font-size:26px;font-variant-numeric:tabular-nums}
.logrow{display:flex;gap:10px;align-items:flex-start;padding:10px 0;border-bottom:1px solid var(--line)}
.logrow .dot{flex:none;width:24px;height:24px;border-radius:50%;display:grid;place-items:center;font-size:14px;font-weight:700}
.logrow .dot.good{background:var(--green-soft);color:var(--green)}
.logrow .dot.bad{background:var(--red-soft);color:var(--red)}
.field{display:block;margin:12px 0}
.field span{display:block;font-weight:600;margin-bottom:4px}
.field small{display:block;color:var(--muted);font-size:13px;line-height:1.4;margin-top:2px}
.field .input{width:100%;flex:none}
.vrow{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;text-align:left;background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:10px 14px;margin-bottom:6px;min-height:56px}
.vrow .k{font-size:20px;font-weight:600}
.vrow .t{color:var(--muted);font-size:15px;text-align:right}
[hidden]{display:none!important}
.ic{display:block}
.ic .f{fill:var(--ink)}
.ic .fa{fill:var(--blue)}
.ic .bg{fill:var(--surface)}
.ic .s{fill:none;stroke:var(--ink);stroke-width:4;stroke-linecap:round;stroke-linejoin:round}
.ic .sa{fill:none;stroke:var(--blue);stroke-width:5;stroke-linecap:round;stroke-linejoin:round}
.steps{display:flex;gap:6px;margin:0 0 12px}
.steps span{flex:1;text-align:center;font-size:13px;line-height:1.3;padding:7px 4px;border-radius:10px;background:var(--blue-soft);color:var(--muted);font-weight:600}
.steps span.on{background:var(--blue);color:var(--on-blue)}
.steps span.ok{background:var(--green-soft);color:var(--green)}
.tray{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:12px 0}
.tool{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;padding:12px 8px;background:var(--surface);border:2px solid var(--line);border-radius:16px;min-height:112px}
.tool b{font-size:15px;line-height:1.3;text-align:center;word-break:keep-all}
.tool.wrong{border-color:var(--red);animation:shake .3s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
@media (prefers-reduced-motion: reduce){.tool.wrong{animation:none}}
.scene{display:block;width:100%;height:auto;background:var(--surface);border:1px solid var(--line);border-radius:16px;touch-action:none;-webkit-user-select:none;user-select:none}
.holdbtn{width:100%;min-height:64px;margin-top:10px;border-radius:16px;border:0;background:var(--blue);color:var(--on-blue);font-weight:700;font-size:18px;touch-action:none;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
.holdbtn.on{background:var(--red);color:#fff}
.act-hint{color:var(--muted);margin:8px 0 0;text-align:center}
.seg-row{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
.wd{background:var(--blue-soft);border-radius:10px;padding:6px 10px;text-align:center}
.wd b{display:block;font-size:19px;line-height:1.4}
.wd small{color:var(--muted);font-size:13px}
.ok-title{font-weight:700;color:var(--green);font-size:18px;margin-bottom:4px}
.pills{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}
</style>
</head>
<body>
<div id="app"></div>
<script>
(function(){
'use strict';

/* ---------- storage (falls back to memory if the browser blocks it) ---------- */
const store=(function(){
  const mem={};let ok=false;
  try{localStorage.setItem('__eps','1');localStorage.removeItem('__eps');ok=true;}catch(e){}
  return{
    persistent:ok,
    get(k,d){
      try{if(ok){const v=localStorage.getItem(k);if(v!==null)return JSON.parse(v);}}catch(e){}
      return Object.prototype.hasOwnProperty.call(mem,k)?mem[k]:d;
    },
    set(k,v){mem[k]=v;try{if(ok)localStorage.setItem(k,JSON.stringify(v));}catch(e){}}
  };
})();

/* ---------- Korean numbers ---------- */
const SD=['','일','이','삼','사','오','육','칠','팔','구'];
function sino(n){
  n=Math.floor(n);if(n===0)return'영';
  const th=Math.floor(n/1000),h=Math.floor(n%1000/100),t=Math.floor(n%100/10),o=n%10;
  let s='';
  if(th)s+=(th>1?SD[th]:'')+'천';
  if(h)s+=(h>1?SD[h]:'')+'백';
  if(t)s+=(t>1?SD[t]:'')+'십';
  return s+SD[o];
}
const NO=['','한','두','세','네','다섯','여섯','일곱','여덟','아홉'];
const NT=['','열','스물','서른','마흔','쉰','예순','일흔','여든','아흔'];
function native(n){
  if(n<1||n>99)return String(n);
  if(n===20)return'스무';
  return NT[Math.floor(n/10)]+NO[n%10];
}
function hasBatchim(s){const c=s.charCodeAt(s.length-1)-0xAC00;return c>=0&&c<11172&&c%28!==0;}
function josa(w,a,b){return w+(hasBatchim(w)?a:b);}
function monthKo(m){return m===6?'유월':m===10?'시월':sino(m)+'월';}

/* ---------- text similarity (jamo level) ---------- */
function norm(s){return String(s||'').replace(/[\s.,!?~·'"“”‘’()\/\-–—]/g,'').normalize('NFD');}
function lev(a,b){
  const m=a.length,n=b.length;if(!m)return n;if(!n)return m;
  let prev=new Array(n+1),cur=new Array(n+1);
  for(let j=0;j<=n;j++)prev[j]=j;
  for(let i=1;i<=m;i++){
    cur[0]=i;
    for(let j=1;j<=n;j++){cur[j]=Math.min(prev[j]+1,cur[j-1]+1,prev[j-1]+(a[i-1]===b[j-1]?0:1));}
    const t=prev;prev=cur;cur=t;
  }
  return prev[n];
}
function sim(a,b){a=norm(a);b=norm(b);const L=Math.max(a.length,b.length);return L?1-lev(a,b)/L:1;}

/* ---------- content from the handout ---------- */
const ACK=['네, 알겠습니다.','예, 알겠습니다.','알겠습니다.'];

const MOTION=[
 ['왼손을 올리세요 / 왼손을 드세요','왼손을 올리세요','ยกมือซ้ายขึ้น'],
 ['왼손을 내리세요','왼손을 내리세요','ลดมือซ้ายลง'],
 ['오른손을 올리세요 / 오른손을 드세요','오른손을 올리세요','ยกมือขวาขึ้น'],
 ['오른손을 내리세요','오른손을 내리세요','ลดมือขวาลง'],
 ['양손을 올리세요','양손을 올리세요','ยกมือสองข้างขึ้น'],
 ['양손을 내리세요','양손을 내리세요','ลดมือสองข้างลง'],
 ['뒤로 돌아서세요','뒤로 돌아서세요','หันหลังกลับ'],
 ['앞으로 돌아서세요','앞으로 돌아서세요','หันกลับมาข้างหน้า'],
 ['뒤로 돌아가세요','뒤로 돌아가세요','ถอยหลังไป'],
 ['왼쪽으로 가세요','왼쪽으로 가세요','ไปทางซ้าย'],
 ['오른쪽으로 가세요','오른쪽으로 가세요','ไปทางขวา'],
 ['멈추세요','멈추세요','หยุด'],
 ['위를 보세요','위를 보세요','มองขึ้นข้างบน'],
 ['아래를 보세요','아래를 보세요','มองลงข้างล่าง'],
 ['앞을 보세요','앞을 보세요','มองตรงไปข้างหน้า'],
 ['왼쪽을 보세요','왼쪽을 보세요','มองไปทางซ้าย'],
 ['오른쪽을 보세요','오른쪽을 보세요','มองไปทางขวา'],
 ['이리 오세요','이리 오세요','มาทางนี้'],
 ['저리 가세요','저리 가세요','ไปทางโน้น'],
 ['의자에 앉으세요','의자에 앉으세요','นั่งลงบนเก้าอี้'],
 ['의자에서 일어나세요','의자에서 일어나세요','ลุกขึ้นจากเก้าอี้']
];

const TOOLS=[
 ['플라이어 / 펜치를 가져 와서 철사를 펴는 / 구부리는 행동하세요.','플라이어를 가져와서 철사를 펴는 행동하세요.','เอาคีมมา แล้วทำท่ายืดหรืองอลวดเหล็ก'],
 ['스패너를 가져 와서 너트를 조이는 행동하세요.','스패너를 가져와서 너트를 조이는 행동하세요.','เอาประแจปากตายมา แล้วทำท่าขันน็อต'],
 ['버니어캘리퍼스를 가져 와서 나사못의 길이를 재는 행동하세요.','버니어캘리퍼스를 가져와서 나사못의 길이를 재는 행동하세요.','เอาเวอร์เนียร์คาลิปเปอร์มา แล้วทำท่าวัดความยาวของสกรู'],
 ['육각렌치를 가져 와서 육각볼트를 조이는 행동하세요.','육각렌치를 가져와서 육각볼트를 조이는 행동하세요.','เอาประแจหกเหลี่ยมมา แล้วทำท่าขันโบลต์หกเหลี่ยม'],
 ['망치를 가져 와서 못을 박는 행동하세요.','망치를 가져와서 못을 박는 행동하세요.','เอาค้อนมา แล้วทำท่าตอกตะปู'],
 ['드라이버를 가져 와서 나사못을 조이는 행동하세요.','드라이버를 가져와서 나사못을 조이는 행동하세요.','เอาไขควงมา แล้วทำท่าขันสกรู'],
 ['니퍼를 가져 와서 철사를 자르는 행동하세요.','니퍼를 가져와서 철사를 자르는 행동하세요.','เอาคีมตัดมา แล้วทำท่าตัดลวดเหล็ก'],
 ['칼 / 가위를 가져 와서 종이를 자르는 행동하세요.','가위를 가져와서 종이를 자르는 행동하세요.','เอามีดหรือกรรไกรมา แล้วทำท่าตัดกระดาษ'],
 ['전기드릴을 가져 와서 나무판 / 원목을 뚫는 행동하세요.','전기드릴을 가져와서 나무판을 뚫는 행동하세요.','เอาสว่านไฟฟ้ามา แล้วทำท่าเจาะแผ่นไม้หรือไม้ท่อน'],
 ['톱을 가져 와서 나무판 / 원목을 자르는 행동하세요.','톱을 가져와서 나무판을 자르는 행동하세요.','เอาเลื่อยมา แล้วทำท่าตัดแผ่นไม้หรือไม้ท่อน'],
 ['줄자를 가져 와서 철사 / 철근의 길이 재는 행동하세요.','줄자를 가져와서 철사의 길이를 재는 행동하세요.','เอาตลับเมตรมา แล้วทำท่าวัดความยาวลวดหรือเหล็กเส้น']
];

const VOCAB=[
 ['เครื่องมือ',[['플라이어 / 펜치','คีม'],['스패너','ประแจปากตาย'],['육각렌치','ประแจหกเหลี่ยม'],['버니어캘리퍼스','เวอร์เนียร์คาลิปเปอร์'],['망치','ค้อน'],['드라이버','ไขควง'],['니퍼','คีมตัด'],['칼 / 가위','มีด / กรรไกร'],['전기드릴','สว่านไฟฟ้า'],['톱','เลื่อย'],['줄자','ตลับเมตร']]],
 ['สิ่งของ',[['육각볼트','โบลต์หกเหลี่ยม'],['못','ตะปู'],['너트','น็อต'],['나사못','สกรู'],['철사','ลวดเหล็ก'],['철근','เหล็กเส้น'],['종이','กระดาษ'],['나무판 / 원목','แผ่นไม้ / ไม้ท่อน'],['길이','ความยาว']]],
 ['คำกริยา',[['가져 오다','เอามา'],['펴다 / 구부리다','ยืด / งอ'],['조이다','ขัน'],['박다','ตอก'],['자르다','ตัด'],['뚫다','เจาะ'],['재다','วัด'],['행동하세요','ทำท่าทาง / ดำเนินการ']]]
];

/* ---------- hands-on tool workbench ---------- */
const TSPEC=[
 {tool:'pliers',mats:['wire'],toolKo:'플라이어 / 펜치',toolTh:'คีม',act:'bend',tp:['플라이어 / 펜치를','คีม'],op:['철사를','ลวดเหล็ก'],vp:['펴는 / 구부리는','ยืด / งอ']},
 {tool:'spanner',mats:['nut'],toolKo:'스패너',toolTh:'ประแจปากตาย',act:'rotate',kind:'nut',tp:['스패너를','ประแจปากตาย'],op:['너트를','น็อต'],vp:['조이는','ขัน']},
 {tool:'caliper',mats:['screw'],toolKo:'버니어캘리퍼스',toolTh:'เวอร์เนียร์คาลิปเปอร์',act:'extend',kind:'caliper',tp:['버니어캘리퍼스를','เวอร์เนียร์คาลิปเปอร์'],op:['나사못의 길이를','ความยาวของสกรู'],vp:['재는','วัด']},
 {tool:'hexkey',mats:['hexbolt'],toolKo:'육각렌치',toolTh:'ประแจหกเหลี่ยม',act:'rotate',kind:'hexbolt',tp:['육각렌치를','ประแจหกเหลี่ยม'],op:['육각볼트를','โบลต์หกเหลี่ยม'],vp:['조이는','ขัน']},
 {tool:'hammer',mats:['nail'],toolKo:'망치',toolTh:'ค้อน',act:'tap',tp:['망치를','ค้อน'],op:['못을','ตะปู'],vp:['박는','ตอก']},
 {tool:'screwdriver',mats:['screw'],toolKo:'드라이버',toolTh:'ไขควง',act:'rotate',kind:'screw',tp:['드라이버를','ไขควง'],op:['나사못을','สกรู'],vp:['조이는','ขัน']},
 {tool:'nipper',mats:['wire'],toolKo:'니퍼',toolTh:'คีมตัด',act:'nipper',tp:['니퍼를','คีมตัด'],op:['철사를','ลวดเหล็ก'],vp:['자르는','ตัด']},
 {tool:'scissors',mats:['paper'],toolKo:'칼 / 가위',toolTh:'มีด / กรรไกร',act:'cut',tp:['칼 / 가위를','มีด / กรรไกร'],op:['종이를','กระดาษ'],vp:['자르는','ตัด']},
 {tool:'drill',mats:['wood'],toolKo:'전기드릴',toolTh:'สว่านไฟฟ้า',act:'drill',tp:['전기드릴을','สว่านไฟฟ้า'],op:['나무판 / 원목을','แผ่นไม้ / ไม้ท่อน'],vp:['뚫는','เจาะ']},
 {tool:'saw',mats:['wood'],toolKo:'톱',toolTh:'เลื่อย',act:'saw',tp:['톱을','เลื่อย'],op:['나무판 / 원목을','แผ่นไม้ / ไม้ท่อน'],vp:['자르는','ตัด']},
 {tool:'tape',mats:['wire','rebar'],toolKo:'줄자',toolTh:'ตลับเมตร',act:'extend',kind:'tape',tp:['줄자를','ตลับเมตร'],op:['철사 / 철근의 길이를','ความยาวของลวด / เหล็กเส้น'],vp:['재는','วัด']}
];
const TNAME={};TSPEC.forEach(s=>{TNAME[s.tool]=s.toolKo;});

